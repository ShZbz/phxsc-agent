# PhySc-agent 环境变量模板
# 复制为 .env 并填入你的 key（.env 已被 .gitignore 排除，不会提交）

# ── 必填 ──────────────────────────────────────────────
# DeepSeek API Key（主模型 provider）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ── 可选 ──────────────────────────────────────────────
# 智谱 API Key（语义 embedding → 语义缓存/记忆混合检索；不设则降级为 exact-only）
ZHIPU_API_KEY=

# Tavily API Key（网页搜索工具；免费额度 1000 次/月；不设则该工具不可用）
TAVILY_API_KEY=

# 工作目录（默认 <项目根>/workspace）
#PHXSC_WORKDIR=

# 记忆库路径（默认 workspace/memory.db）
#PHXSC_DB=

# embedding 后端：api（默认，智谱）/ local（本地 bge 离线，需安装 memory extra）
#PHXSC_EMBED_BACKEND=api

# 非流式 LLM 请求超时（秒，默认 300）
#PHXSC_LLM_TIMEOUT=300

# 流式 LLM chunk 超时（秒，默认 60）
#PHXSC_LLM_STREAM_TIMEOUT=60

# 长任务两阶段：0 禁用
#PHXSC_LONGTASK=

# 记忆混合检索启用阈值（记忆数超过才双路召回，默认 1000）
#PHXSC_HYBRID_THRESHOLD=1000

# telemetry 输出路径（默认 workspace/tmp/telemetry.jsonl）
#PHXSC_TELEMETRY_PATH=
